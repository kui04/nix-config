{
    "defaultPolicy": {
        "tools": "allow",
        "bash": "ask",
        "mcp": "allow",
        "skills": "allow",
        "special": "ask"
    },
    "tools": {
        "read": "allow",
        "write": "ask",
        "edit": "ask",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "bash": "ask",
        "mcp": "allow"
    },
    "bash": {
        "ls *": "allow",
        "cat *": "allow",
        "head *": "allow",
        "tail *": "allow",
        "pwd": "allow",
        "echo *": "allow",
        "which *": "allow",
        "type *": "allow",
        "file *": "allow",
        "wc *": "allow",
        "stat *": "allow",
        "uname *": "allow",
        "date": "allow",
        "du -sh *": "allow",
        "df -h *": "allow",
        "env": "allow",
        "printenv *": "allow",
        "bat *": "allow",
        "boo *": "allow",
        "diff *": "allow",
        "git status": "allow",
        "git diff *": "allow",
        "git log *": "allow",
        "git show *": "allow",
        "git branch *": "allow",
        "journalctl *": "allow",
        "ps *": "allow",
        "top": "allow",
        "htop": "allow",
        "btm": "allow",
        "jobs": "allow",
        "ping *": "allow",
        "ss *": "allow",
        "netstat *": "allow",
        "nmap *": "allow",
        "find *": "allow",
        "grep *": "allow",
        "rg *": "allow",
        "ag *": "allow",
        "fd *": "allow",
        "sort *": "allow",
        "uniq *": "allow",
        "cut *": "allow",
        "tr *": "allow",
        "jq *": "allow",
        "yq *": "allow",
        "curl *": "allow",
        "*": "ask"
    }
}