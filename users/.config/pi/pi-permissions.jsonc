{
    "defaultPolicy": {
        "*":                                         "ask",
        "bash":                                      "ask",
        "special":                                   "ask",
        "tools":                                     "allow",
        "mcp":                                       "allow",
        "skills":                                    "allow"
    },
    "tools": {
        "*":                                         "ask",
        "write":                                     "ask",
        "edit":                                      "ask",
        "bash":                                      "ask",
        "ask_user":                                  "allow",
        "read":                                      "allow",
        "grep":                                      "allow",
        "find":                                      "allow",
        "ls":                                        "allow",
        "mcp":                                       "allow"
    },
    "bash": {
        "*":                                         "ask",
        "ag *":                                      "allow",
        "bat *":                                     "allow",
        "btm":                                       "allow",
        "cat *":                                     "allow",
        "curl *":                                    "allow",
        "cut *":                                     "allow",
        "date":                                      "allow",
        "df -h *":                                   "allow",
        "diff *":                                    "allow",
        "du -sh *":                                  "allow",
        "echo *":                                    "allow",
        "env":                                       "allow",
        "fd *":                                      "allow",
        "file *":                                    "allow",
        "find *":                                    "allow",
        "git branch *":                              "allow",
        "git diff *":                                "allow",
        "git log *":                                 "allow",
        "git show *":                                "allow",
        "git status":                                "allow",
        "grep *":                                    "allow",
        "head *":                                    "allow",
        "htop":                                      "allow",
        "jq *":                                      "allow",
        "jobs":                                      "allow",
        "journalctl *":                              "allow",
        "ls *":                                      "allow",
        "netstat *":                                 "allow",
        "nmap *":                                    "allow",
        "ping *":                                    "allow",
        "printenv *":                                "allow",
        "ps *":                                      "allow",
        "pwd":                                       "allow",
        "rg *":                                      "allow",
        "rtk *":                                     "allow",
        "sleep *":                                   "allow",
        "sort *":                                    "allow",
        "ss *":                                      "allow",
        "stat *":                                    "allow",
        "tail *":                                    "allow",
        "top":                                       "allow",
        "tr *":                                      "allow",
        "type *":                                    "allow",
        "uname *":                                   "allow",
        "uniq *":                                    "allow",
        "wc *":                                      "allow",
        "which *":                                   "allow",
        "yq *":                                      "allow"
    }
}
