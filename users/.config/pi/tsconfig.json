{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "types": ["node"]
    },
    "include": ["extensions/**/*.ts"]
}
