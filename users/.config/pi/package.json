{
    "name": "pi-extension-dev",
    "private": true,
    "type": "module",
    "description": "Dev environment for the pi extensions in ./extensions",
    "scripts": {
        "check": "tsc --noEmit && eslint . && prettier --check .",
        "format": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.5.2",
        "@eslint/js": "10.0.1",
        "@types/node": "22.19.19",
        "eslint": "10.15.0",
        "prettier": "3.10.1",
        "typebox": "1.3.27",
        "typescript": "5.9.3",
        "typescript-eslint": "8.73.0"
    }
}
