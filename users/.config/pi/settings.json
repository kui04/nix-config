{
  "packages": [
    "npm:pi-ask-user",
    "npm:pi-mcp-adapter",
    "npm:pi-permission-system",
    "npm:pi-zentui",
    "git:github.com/elpapi42/pi-observational-memory",
    "git:github.com/fgrehm/pi-ollama-cloud",
    "git:github.com/kui04/pi-ast-edit@dev"
  ],

  "followUpMode": "all",
  "quietStartup": true,
  "steeringMode": "all",
  "httpIdleTimeoutMs": 60000,
  "npmCommand": [ "npm" ],
  "tuiMode": "fullscreen",

  "observational-memory": {
    "observeAfterTokens": 20000,
    "reflectAfterTokens": 50000,
    "compactAfterTokens": 128000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.618,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": { "thinking": "off" },
    "passive": false,
    "debugLog": false
  },

  "ast-edit": {
    "traceEnabled": true,
    "autoReflect": true,
    "reflectAfterErrors": 5
  }
}