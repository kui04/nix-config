// A template for sing-box client config (single server).
// Hand-managed at /etc/sing-box/config.json on thinkbook; never in git.
// Generated by users/fkgfw/gen.sh. Replace SERVER_IP_OR_DOMAIN with the
// VPS IP or domain, validate with `sing-box check`, then restart the service.
{
  "log": {
    "level": "info"
  },
  // remote rule-sets below download through this client, which
  // detours via the proxy group. replaces download_detour, removed
  // in sing-box 1.16.
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "proxy"
    }
  ],
  "dns": {
    "servers": [
      // Both branches are DoH: plain udp/53 is injectable on the way to the
      // resolver, and plain tcp through the tunnel costs ~0.5s per uncached
      // name. IP literals keep the resolver from needing its own bootstrap.
      {
        "tag": "dns-cn",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      {
        "tag": "dns-proxy",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "proxy"
      },
      {
        "tag": "ts-dns",
        "type": "udp",
        "server": "100.100.100.100",
        "bind_interface": "tailscale0"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "reject"
      },
      {
        "domain_suffix": ["ts.net"],
        "action": "route",
        "server": "ts-dns"
      },
      // Microsoft hands out China CDN edges to Chinese resolvers, and some of
      // them reset TLS. Ask Cloudflare so the answer is the global CDN.
      {
        "domain_suffix": ["microsoft.com"],
        "action": "route",
        "server": "dns-proxy"
      },
      // tailscaled resolves its own control and DERP names. Keep that on the
      // direct resolver so the tailnet still comes up when the proxy is down.
      {
        "process_path_regex": [".*tailscale.*"],
        "action": "route",
        "server": "dns-cn"
      },
      // Mirror the route order below: a name must resolve on the same side it
      // connects from. Otherwise a proxy-routed name gets a domestic CDN
      // address the VPS cannot reach, as dl.google.com did.
      {
        "rule_set": ["geosite-apple", "geosite-category-games@cn", "geosite-google-play@cn"],
        "action": "route",
        "server": "dns-cn"
      },
      {
        "rule_set": ["geosite-google", "geosite-geolocation-!cn"],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": ["geosite-cn", "geosite-private"],
        "action": "route",
        "server": "dns-cn"
      }
    ],
    "final": "dns-proxy"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      // fixed name: the firewall rpfilter fix in services/sing-box.nix uses it
      "interface_name": "tun0",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "stack": "system",
      "auto_route": true,
      // stays on: off it loses all browser traffic and captures the LAN
      "auto_redirect": true,
      "strict_route": true,
      // tailscale: fallback path when the proxy breaks, plus MagicDNS.
      // NTP: the clock must sync even when the proxy is down (keep in sync
      // with services.timesyncd.servers).
      "route_exclude_address": [
        "100.64.0.0/10",
        "fd7a:115c:a1e0::/48",
        "203.107.6.88/32",
        "106.55.184.199/32",
        "113.141.164.38/32"
      ]
    }
  ],
  "outbounds": [
    {
      // Manual selector: TUIC is the default. Change the default or use the
      // API/dashboard to force another path. A switch interrupts existing
      // connections so that all traffic uses the selected path.
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["tuic", "hysteria2", "vless-reality-vision"],
      "default": "tuic",
      "interrupt_exist_connections": true
    },
    {
      "type": "vless",
      "tag": "vless-reality-vision",
      "server": "SERVER_IP_OR_DOMAIN",
      "server_port": 443,
      "uuid": "VLESS_UUID",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "server_name": "TLS_SERVER_NAME",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "VLESS_PUBLIC_KEY",
          "short_id": ""
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "SERVER_IP_OR_DOMAIN",
      "server_port": 443,
      "server_ports": ["20000:50000"],
      "password": "HY2_PASSWORD",
      "up_mbps": 200,
      "down_mbps": 1000,
      "tls": {
        "enabled": true,
        "server_name": "TLS_SERVER_NAME",
        "alpn": ["h3"],
        "certificate_public_key_sha256": ["FINGERPRINT_PUBKEY_B64"]
      }
    },
    {
      "type": "tuic",
      "tag": "tuic",
      "server": "SERVER_IP_OR_DOMAIN",
      "server_port": 8443,
      "uuid": "TUIC_UUID",
      "password": "TUIC_PASSWORD",
      "congestion_control": "bbr",
      "udp_relay_mode": "native",
      "zero_rtt_handshake": false,
      "heartbeat": "10s",
      "tls": {
        "enabled": true,
        "server_name": "TLS_SERVER_NAME",
        "alpn": ["h3"],
        "certificate_public_key_sha256": ["FINGERPRINT_PUBKEY_B64"]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "dns-cn"
    },
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple@cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google-play@cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google-play@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-category-games@cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-games@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      // tailscale range, including MagicDNS. plain route (not a bypass),
      // so tailnet DNS still passes the dns section above.
      {
        "ip_cidr": ["100.64.0.0/10", "fd7a:115c:a1e0::/48"],
        "action": "route",
        "outbound": "direct"
      },
      // NixOS runs the daemon as .tailscaled-wrapped, so process_name never
      // matched and its control/DERP TCP was sent to the proxy. Match the path.
      {
        "process_path_regex": [".*tailscale.*", ".*NetworkManager$"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_cidr": ["224.0.0.0/4", "ff00::/8"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      // same order as the mihomo template: ads, private, CN CDNs,
      // google, off-CN, CN, then GEOIP CN.
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "reject"
      },
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-category-games@cn", "geosite-apple@cn", "geosite-apple", "geosite-google-play@cn"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-google"],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": ["geosite-cn", "geoip-cn"],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_http_client": "proxy-client"
  },
  // official dashboard (sing-box-dashboard.sagernet.org) talks to
  // this gRPC-Web API, not to clash_api. enter 127.0.0.1:9090
  // in the panel with empty secret.
  "services": [
    {
      "type": "api",
      "tag": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "access_control_allow_origin": [
        "http://sing-box-dashboard.sagernet.org",
        "https://sing-box-dashboard.sagernet.org"
      ],
      "access_control_allow_private_network": true
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "cache_id": "fkgfw-la-v1"
    }
  }
}
